# Copy this to .env.local and fill in your values
# Never commit .env.local

# NVIDIA NIM API key — free at build.nvidia.com
NVIDIA_API_KEY=

# 0G Compute API key — from pc.0g.ai
ZG_API_KEY=

# 0G wallet private key (funded via faucet.0g.ai)
ZG_PRIVATE_KEY=

# 0G Chain RPC
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# Deployed AgentBetGame.sol contract address
ZG_CONTRACT_ADDRESS=0x960151387D9661eE84bacfffdea886ADF1911338

# Deployed CHIPToken.sol ERC20 address
ZG_CHIP_TOKEN_ADDRESS=

# 0G Storage
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZG_KV_NODE_RPC=http://3.101.147.150:6789

# Socket.io server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
