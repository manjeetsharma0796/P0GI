{
  "name": "agentbet-initia",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [3000, 3001, 26657, 1317, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js — open me",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "3001": {
      "label": "socket.io poker server",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "26657": {
      "label": "Rollup RPC",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "1317": {
      "label": "Rollup REST",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "8080": {
      "label": "Rollup indexer (explorer)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "NEXT_PUBLIC_ROLLUP_CHAIN_ID": "agentbet-1"
  },
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "oven.bun-vscode"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
