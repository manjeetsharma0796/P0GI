# 0G Integration — copy to .env.local and fill in your values
# Never commit .env.local

# ── Existing (keep these) ───────────────────────────
NVIDIA_API_KEY=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── 0G Compute (AI inference) ───────────────────────
# Get from: https://pc.0g.ai → Dashboard → API Keys → Create
ZG_API_KEY=

# ── 0G Wallet ───────────────────────────────────────
# Your wallet private key (the one funded via faucet)
# Used for: contract deployment, gas station, funding agents
ZG_PRIVATE_KEY=

# ── 0G Chain ────────────────────────────────────────
# RPC endpoint (defaults to Galileo testnet)
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# Contract address — fill AFTER deploying AgentBetGame.sol
# Deploy: cd 0g/chain && bunx hardhat run scripts/deploy.js --network 0g-testnet
ZG_CONTRACT_ADDRESS=

# Deployed CHIPToken.sol ERC20 address
# e.g. 0xB970397578F1033a886F70A6538559117Fc828A6
ZG_CHIP_TOKEN_ADDRESS=

# ── 0G Storage ──────────────────────────────────────
# Indexer RPC (turbo = faster, standard = cheaper)
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# KV node for leaderboard reads
ZG_KV_NODE_RPC=http://3.101.147.150:6789

# Stream ID for leaderboard KV store (create one or leave empty to skip KV)
ZG_STREAM_ID=

# ── 0G Sealed Inference (TEE) ──────────────────────
# Provider address for TEE-verified inference
# Discover available providers via listAvailableProviders()
ZG_SEALED_PROVIDER=

# ── Funder (for fund-agents.ts script) ──────────────
# Private key of the wallet that will distribute 0G to agent wallets
# Can be the same as ZG_PRIVATE_KEY
FUNDER_PRIVATE_KEY=
